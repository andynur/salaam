{
  "name": "hsi-learning-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": { "bun": ">=1.4.2" },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "start": "NODE_ENV=production bun dist/server.js",
    "db:migrate": "bun src/core/database/migrate.ts",
    "db:migrate:rollback": "bun src/core/database/rollback.ts",
    "db:migrate:reset": "bun src/core/database/reset.ts",
    "db:seed": "bun database/seed/admin.ts",
    "db:bootstrap-admin": "bun database/seed/bootstrap-admin.ts"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
