NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/salaam
STORAGE_ROOT=./storage
# Backups contain a PostgreSQL dump and a matching storage archive.
# Keep this outside the application tree and on a separate protected volume in production.
# BACKUP_ROOT=./backups
# BACKUP_RETENTION_DAYS=14
SCHOOL_TIMEZONE=Asia/Jakarta
# Opaque, random 256-bit tokens are hashed in PostgreSQL; no signing secret needed.
SESSION_TTL_HOURS=12
# Explicit development seed only. Supply these privately before bun run db:seed.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=
# TEST_DATABASE_URL=postgres://localhost:5432/salaam_test
# Optional isolated coding runner. The application never executes student code locally.
# CODE_RUNNER_URL=https://runner.internal.example/api/v1/execute
# CODE_RUNNER_TOKEN=
# CODE_RUNNER_TIMEOUT_MS=5000
# First administrator only; works in production after migrations.
# Supply privately before bun run db:bootstrap-admin, then remove.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_IDENTIFIER=
# BOOTSTRAP_ADMIN_PASSWORD=
